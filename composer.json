{
    "name": "manza/manza-php",
    "description": "PHP SDK for the Manza API",
    "license": "MIT",
    "type": "library",
    "keywords": ["manza", "api", "sdk", "banking"],
    "homepage": "https://github.com/getmanza/manza-php",
    "support": {
        "email": "hello@get-manza.com",
        "source": "https://github.com/getmanza/manza-php",
        "issues": "https://github.com/getmanza/manza-php/issues"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Manza\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manza\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
